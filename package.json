{
  "name": "@cocreate/db",
  "version": "1.1.0",
  "description": "Local-first JavaScript document database with rich queries, automatic indexing, and distributed data support.",
  "keywords": [
    "cocreate",
    "database",
    "document-database",
    "javascript",
    "nosql",
    "embedded-database",
    "local-first",
    "automatic-indexing",
    "database-engine",
    "distributed-database"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "start": "webpack --config webpack.config.js --watch",
    "build": "NODE_ENV=production webpack --config webpack.config.js",
    "benchmark": "node test/benchmarks/lifecycle.mjs",
    "benchmark:ranges": "node test/benchmarks/diagnostics/ranges.mjs",
    "benchmark:standard": "node test/benchmarks/standard.mjs",
    "benchmark:report": "node test/benchmarks/standard-report.mjs",
    "benchmark:weighted-eviction": "node test/benchmarks/diagnostics/weighted-eviction.mjs",
    "benchmark:deferred-indexing": "node test/benchmarks/diagnostics/deferred-indexing.mjs",
    "benchmark:continuous": "node test/benchmarks/diagnostics/continuous.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "AGPL-3.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CoCreateJS/db.git"
  },
  "author": "CoCreate LLC",
  "bugs": {
    "url": "https://github.com/CoCreateJS/db/issues"
  },
  "type": "module",
  "main": "./src/index.js",
  "browser": "./src/index.js",
  "homepage": "https://CoCreateJS.com/docs/db",
  "dependencies": {
    "@cocreate/disk": "^1.0.0",
    "@cocreate/coson": "^1.0.0",
    "@cocreate/config": "^2.0.2",
    "@cocreate/utils": "^2.0.2"
  },
  "exports": {
    ".": "./src/index.js",
    "./tree": "./src/tree/index.js"
  }
}
